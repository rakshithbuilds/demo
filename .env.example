# ARVA Studio — environment variables (spec §35)
# Copy to `.env.local` and fill in real values. NEVER commit real values.

# --- Supabase (Postgres + Auth + Storage) ---
# Project URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — must never be prefixed NEXT_PUBLIC_ or reach the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend (transactional email) ---
RESEND_API_KEY=re_your_api_key
# Verified sender domain in Resend. Server-only.
RESEND_FROM_EMAIL="ARVA Studio <hello@arvastudios.in>"

# --- Sentry (error monitoring) ---
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Same DSN, exposed to the browser so client-side errors report too.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0

# --- Lead routing ---
# Server-only. Where new lead notifications are sent.
INTERNAL_NOTIFICATION_EMAIL=hello@arvastudios.in

# --- Site ---
# Canonical origin, used for absolute Open Graph and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://arvastudios.in

# --- Booking ---
# Google Calendar scheduling page. While this is unset or left as the placeholder
# below, the "Book a Call" button is hidden/relabelled rather than linking to a
# dead URL (spec §33.7). Replace with the real link to switch the button on.
NEXT_PUBLIC_CALENDAR_LINK=https://calendar.google.com/calendar/appointments/REPLACE_ME
